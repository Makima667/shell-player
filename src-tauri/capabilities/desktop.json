{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "只在桌面版：自动更新和更新后重启、全局快捷键",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister-all"
  ]
}
